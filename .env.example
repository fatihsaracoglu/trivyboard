# Development-only Vite proxy target. This value is not exposed to browser code.
API_PROXY_TARGET=http://127.0.0.1:3030

# Compose publishes the UI on loopback by default. Set 0.0.0.0 deliberately
# only when an external reverse proxy or trusted network should reach it.
TRIVYBOARD_BIND_ADDRESS=127.0.0.1
TRIVYBOARD_PORT=8080

# Optional comma-separated browser origins for direct cross-origin API access.
# Normal Vite and Nginx deployments are same-origin and should leave this empty.
CORS_ALLOWED_ORIGINS=
