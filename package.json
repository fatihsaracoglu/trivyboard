{
  "name": "trivyboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Trivy vulnerability dashboard with image / filesystem / repository scanning.",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc -b",
    "check": "bun run lint && bun run typecheck && bun run backend:vet && bun run backend:test",
    "backend:dev": "cd trivyboard-backend && go run .",
    "backend:build": "cd trivyboard-backend && go build -o trivyboard-backend-bin .",
    "backend:test": "cd trivyboard-backend && go test ./...",
    "backend:vet": "cd trivyboard-backend && go vet ./...",
    "test": "bun run check"
  },
  "dependencies": {
    "@lucide/vue": "^1.46.0",
    "clsx": "^2.1.1",
    "pinia": "^4.0.3",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@types/node": "^24.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.10.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
